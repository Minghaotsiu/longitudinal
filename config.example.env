# Copy this file to config.env and edit the paths for your system.

PROJECT_ROOT=/absolute/path/to/soybean-microneedle-transcriptome
PROCESSED_DATA_DIR=/absolute/path/to/doudou_all34
BATCH1_UPSTREAM_DIR=/absolute/path/to/first_batch/upstream_run
BATCH2_UPSTREAM_DIR=/absolute/path/to/second_batch/upstream_run
BATCH_UPSTREAM_DIR=$BATCH2_UPSTREAM_DIR
UPSTREAM_DIR=/absolute/path/to/combined/upstream_run

SOYBEAN_GTF=/absolute/path/to/Glycine_max.Glycine_max_v2.1.63.chr.gtf
STAR_INDEX=/absolute/path/to/star_index
SOYBEAN_EXON_BED=/absolute/path/to/exon.bed
SOYBEAN_GENE_BED=/absolute/path/to/gene.bed
MT_GENE_FILE=/absolute/path/to/mt_gene.txt
RP_GENE_FILE=/absolute/path/to/ncbi_rp_id.txt

SELECTED5_OUTPUT_DIR=outputs/doudou_selected5_v2
PSEUDOTIME_OUTPUT_DIR=outputs/doudou_selected5_pseudotime
ALL34_OUTPUT_DIR=outputs/doudou_all34_downstream
BATCH_OUTPUT_DIR=outputs/doudou_v2_downstream

PYTHON_BIN=python3
RSCRIPT_BIN=Rscript

# Optional panel-layout QA resources. Leave empty to skip that optional audit.
PANEL_ALIGNMENT_R=
PANEL_ALIGN_AUDIT=

